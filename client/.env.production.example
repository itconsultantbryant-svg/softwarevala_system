# Production API (Render backend). Set in Vercel → Settings → Environment Variables.
# API origin only. Do not put the Neon DATABASE_URL in the frontend.
REACT_APP_API_URL=https://softwarevala-backend.onrender.com

# Optional: direct Socket.IO URL (WebSockets cannot use Vercel /api proxy)
# REACT_APP_SOCKET_URL=https://softwarevala-backend.onrender.com

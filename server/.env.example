PORT=3006
HOST=0.0.0.0
NODE_ENV=development

# Security
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=replace-with-32-plus-char-key

# Frontend URL for CORS (set to your deployed frontend URL in production)
FRONTEND_URL=http://localhost:3000

# SQLite is local only. Production uses Neon via DATABASE_URL.
DB_PATH=../database/pms.db
UPLOADS_DIR=../uploads
# Optional JSON/urlencoded body cap in MB for non-file APIs (0 uses default 50MB)
API_BODY_LIMIT_MB=50
# Certificate upload cap in MB (default 15 if unset or 0)
CERTIFICATE_MAX_FILE_SIZE_MB=15

# Optional public API base URL used in some file URL responses
API_BASE_URL=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@softwarevalalib.app

# Neon Postgres. Required in production. Never expose this in the Vercel frontend.
# Direct host for a long-lived API process. Neon Functions injects the pooled URL.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/softwarevala?sslmode=require

# Neon Functions runtime (injected/set in the deployment, not for local dev)
# NEON_FUNCTIONS=true
# SKIP_STARTUP_MIGRATIONS=true
# UPLOADS_DIR=/tmp/uploads

# Server-to-server key for application.softwarevalalib.app and website lead sync
MARKETING_SYNC_SECRET=
PUBLIC_SITE_URL=https://softwarevalalib.app
